---
const pathname = Astro.url.pathname;
const linkTo = (section: string) => (pathname === '/' ? `#${section}` : `/#${section}`);
const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-800 bg-neutral-950">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <span class="font-display font-bold text-xl text-stone-100">STELLARIS</span>
        <span class="text-[10px] uppercase tracking-[0.3em] text-stone-500 ml-2">Drone</span>
        <p class="mt-4 text-sm text-stone-500 leading-relaxed max-w-xs">
          Télépilote certifié DGAC basé dans l'Aude. Inspection, captation commerciale et couverture événementielle par drone.
        </p>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-[0.3em] text-stone-400 mb-4">Navigation</h4>
        <nav class="flex flex-col gap-3 text-sm text-stone-500">
          <a href={linkTo('services')} class="hover:text-gold-400 transition-colors">Services</a>
          <a href={linkTo('portfolio')} class="hover:text-gold-400 transition-colors">Portfolio</a>
          <a href={linkTo('tarifs')} class="hover:text-gold-400 transition-colors">Tarifs</a>
          <a href={linkTo('contact')} class="hover:text-gold-400 transition-colors">Contact</a>
        </nav>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-[0.3em] text-stone-400 mb-4">Contact</h4>
        <div class="flex flex-col gap-3 text-sm text-stone-500">
          <a href="mailto:contact@stellarisdrone.com" class="hover:text-gold-400 transition-colors">contact@stellarisdrone.com</a>
          <a href="tel:+33781730114" class="hover:text-gold-400 transition-colors">07 81 73 01 14</a>
          <p>Montseret, 11200 · Aude</p>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-neutral-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-600">
      <p>&copy; {year} Stellaris Drone — Mathieu Toffolon</p>
      <div class="flex gap-6">
        <a href="/mentions-legales" class="hover:text-stone-400 transition-colors">Mentions légales</a>
        <a href="/politique-confidentialite" class="hover:text-stone-400 transition-colors">Politique de confidentialité</a>
      </div>
    </div>
  </div>
</footer>
